# URL publique de JA MAKER
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Base SQLite locale persistante. PostgreSQL sera utilisé en production.
JAMAKER_DATABASE_PATH=.data/jamaker.sqlite

# Turso (SQLite cloud, free tier) pour deploy serverless type Vercel.
# https://turso.tech → créer DB → copier URL + token. Vide = mode local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Ces valeurs seront ajoutées lors de l'intégration authentification/paiement.
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Coffre chiffré AES-256-GCM : 32 octets encodés base64. Générer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JAMAKER_VAULT_KEY=
